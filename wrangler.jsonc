{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "eln-app",
	"compatibility_date": "2026-05-12",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},

	// Workers AI binding — used by /api/transcribe for Whisper speech-to-text.
	// wrangler dev proxies this to real Cloudflare inference via your
	// `wrangler login` session, no API token needed.
	"ai": { "binding": "AI" }
}
