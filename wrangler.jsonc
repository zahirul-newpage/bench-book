{
	"$schema": "node_modules/wrangler/config-schema.json",
	// worker-entry.ts wraps OpenNext's generated .open-next/worker.js to add
	// a `queue` handler (the stock-deduction consumer) — see that file.
	"main": "worker-entry.ts",
	"name": "eln-app",
	"compatibility_date": "2026-05-12",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},

	// Not sensitive — plain vars, not secrets. AUTH_SECRET and
	// TURNSTILE_SECRET_KEY (the actual sensitive values) are set separately
	// via `wrangler secret put` (production) / `.dev.vars` (local, gitignored).
	"vars": {
		"AUTH_TRUST_HOST": "true",
		"TURNSTILE_SITEKEY": "0x4AAAAAAFDCRCeLS1KirjcO"
	},

	// Workers AI binding — used by /api/transcribe for Whisper speech-to-text.
	// wrangler dev proxies this to real Cloudflare inference via your
	// `wrangler login` session, no API token needed.
	"ai": { "binding": "AI" },

	// D1 — relational storage for users, notebook entries, and reagent stock.
	"d1_databases": [
		{
			"binding": "bench_book_db",
			"database_name": "bench-book-db",
			"database_id": "aec5f506-54a1-4230-ae2f-34fa623e89ec"
		}
	],

	// KV — hot, read-many cache for the shared reagent list (read by every
	// bench on /inventory and /admin, written rarely). Eventually consistent
	// and rebuildable from D1 at any time — never the source of truth.
	"kv_namespaces": [
		{
			"binding": "bench_book_cache",
			"id": "7603b18144bc4a8b8b20f352deb2abee"
		}
	],

	// Stock deduction queue — createEntry enqueues one message per
	// dictated-reagent that matched inventory instead of deducting stock
	// inline. The consumer (worker-entry.ts) does the actual subtraction.
	// Decouples the entry save (must feel instant to the scientist) from
	// inventory bookkeeping (fine to trail by a few seconds), at the cost of
	// the two no longer succeeding/failing atomically together — see
	// worker-entry.ts for how a permanently-failing deduction is handled.
	"queues": {
		"producers": [
			{
				"queue": "bench-book-stock-deductions",
				"binding": "STOCK_DEDUCTION_QUEUE"
			}
		],
		"consumers": [
			{
				"queue": "bench-book-stock-deductions",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 3
			}
		]
	},

	// Rate limits — cheap reject path before any DB/AI work. Keyed by IP for
	// the unauthenticated endpoints (register/login are pre-auth by nature);
	// transcribe is authenticated, so it's keyed by user id instead.
	"unsafe": {
		"bindings": [
			{
				"name": "REGISTER_LIMITER",
				"type": "ratelimit",
				"namespace_id": "1001",
				"simple": { "limit": 3, "period": 60 }
			},
			{
				"name": "LOGIN_LIMITER",
				"type": "ratelimit",
				"namespace_id": "1002",
				"simple": { "limit": 5, "period": 60 }
			},
			{
				"name": "TRANSCRIBE_LIMITER",
				"type": "ratelimit",
				"namespace_id": "1003",
				"simple": { "limit": 10, "period": 60 }
			}
		]
	}
}
