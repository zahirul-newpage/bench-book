{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    // Imports .open-next/worker.js, which only exists after OpenNext's own
    // build step — a step that runs AFTER `next build`'s TypeScript check,
    // so this file can't be part of that check. It's the Workers entry
    // point, not app code; verify it with `npx tsc --noEmit -p .` after a
    // `npm run preview`/`npm run deploy` has generated .open-next/.
    "worker-entry.ts"
  ]
}
